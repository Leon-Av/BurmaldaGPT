# Скопируй в .env и проставь свои значения.
# Секрет для подписи JWT — обязателен. Сгенерируй:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_me_with_a_long_random_secret

# Опционально — перекрывает config.yaml:
# DATABASE_URL=postgresql://user:password@localhost/burmalda
# TRANSLATOR_BASE_URL=http://localhost:8000

# --- API-ключи облачных провайдеров (если включены в config.yaml) ---
# Реальные ключи хранятся ТОЛЬКО здесь, в .env (не попадают в git).
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GROQ_API_KEY=gsk_...
